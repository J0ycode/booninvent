# --- Required ---
# Postgres connection string (Supabase). In the Supabase dashboard: Connect -> "Transaction pooler" (port 6543).
# It looks like: postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# This is NOT the https://<project-ref>.supabase.co address and NOT an API key.
# Local alternative without Supabase (embedded Postgres saved in a folder): DATABASE_URL=pglite://./.pglite
DATABASE_URL=

# Optional. Used only by `pnpm db:migrate`. Set it to the "Session pooler" string (port 5432) if DATABASE_URL is the
# transaction pooler. If it is empty, DATABASE_URL is used.
DIRECT_URL=

# Secret used to sign session cookies. 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL of the app, used in emailed links (invite, password reset).
APP_URL=http://localhost:3000

# --- Email (optional in development: without SMTP_HOST emails are printed to the console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BoonBaby Store Manager <no-reply@example.com>"

# --- Optional ---
# POST every server error as JSON to this URL (e.g. a Slack/Discord incoming webhook). Errors always go to the server log.
ERROR_WEBHOOK_URL=
